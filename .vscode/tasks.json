{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Rust conflict checker service",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Rust-Services/conflict-checker" 
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Main.js",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/backend/main.js"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Node + Rust",
      "dependsOn": ["Run Backend Main.js", "Run Rust conflict checker service"],
      "dependsOrder": "parallel", 
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
    
  ]
}
